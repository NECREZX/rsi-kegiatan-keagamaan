{
  "builds": [
    {
      "src": "index.php",
      "use": "vercel-php@0.6.2"
    },
    {
      "src": "api/*.php",
      "use": "vercel-php@0.6.2"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/",
      "dest": "/index.php"
    }
  ]
}
