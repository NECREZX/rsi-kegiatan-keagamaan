{
  "builds": [
    {
      "src": "index.php",
      "use": "vercel-php@0.6.2"
    },
    {
      "src": "api/*.php",
      "use": "vercel-php@0.6.2"
    },
    {
      "src": "assets/**",
      "use": "@vercel/static"
    },
    {
      "src": "includes/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/", "dest": "/index.php" }
  ]
}
